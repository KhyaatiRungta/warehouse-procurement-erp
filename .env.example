# Copy to .env and adjust. Values here are for local demos only.

# Postgres (used by docker compose and by the local API)
POSTGRES_DB=warehouse_erp
POSTGRES_USER=erp
POSTGRES_PASSWORD=erp_dev_password

# Local API connection string (when running uvicorn outside Docker)
DATABASE_URL=postgresql+psycopg://erp:erp_dev_password@localhost:5432/warehouse_erp

# Change this before exposing the API anywhere
JWT_SECRET=change-me-to-a-long-random-string-in-production
JWT_TTL_MINUTES=480

# Create the demo accounts and sample data on first start (only when there are no users)
SEED_DEMO=true

# Origins allowed to call the API directly (the Vite dev server by default)
CORS_ORIGINS=http://localhost:5200,http://127.0.0.1:5200

# Host port for the web container in docker compose
WEB_PORT=5200
